# Google AI Studio(https://aistudio.google.com/apikey)에서 발급한 무료 API 키
GEMINI_API_KEY=

# 사용할 모델. 비워두면 scripts/check-gemini.mjs 가 추천하는 값을 넣으세요.
GEMINI_MODEL=

# 관리자 프롬프트 편집 페이지(/admin) 비밀번호
ADMIN_PASSWORD=

# 사람 카드 서버 저장 (Vercel 마켓플레이스에서 Upstash 를 붙이면 자동 주입됨)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 저장소 강제 지정: redis | file | memory (비우면 자동 판별)
# PROFILE_STORE=
